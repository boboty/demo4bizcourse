# 课堂只需要提供 DeepSeek API Key。任何密钥都不要提交进仓库。
#
# Demo 已固定：
#   base_url = https://api.deepseek.com
#   model    = deepseek-flash
LLM_API_KEY=sk-...

# 可选：D 档如需额外演示「不必要的强模型」再配置；课堂默认不需要。
# LLM_STRONG_MODEL=

# 可选
LLM_TIMEOUT_S=60
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=900

# 可选：运行记录输出目录，默认 ./runs
# TOKEN_TASK_RUNS_DIR=./runs
# TOKEN_TASK_SAVE_RUNS=1
