# 复制为 .env 或直接 export。任何密钥都不要提交进仓库。
#
# LLM_BASE_URL 需要包含 API 版本段：客户端会拼接 /chat/completions。
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# 可选：D 档「不必要的强模型」。不配置时 D 档回退到 LLM_MODEL，
# 并在运行记录里注明该项不成立。
# LLM_STRONG_MODEL=gpt-4o

# 可选
LLM_TIMEOUT_S=60
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=900

# 可选：运行记录输出目录，默认 ./runs
# TOKEN_TASK_RUNS_DIR=./runs
# TOKEN_TASK_SAVE_RUNS=1
