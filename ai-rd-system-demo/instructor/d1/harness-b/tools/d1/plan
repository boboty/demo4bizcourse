#!/usr/bin/env bash
set -euo pipefail
plan_file='.d1-harness/plan.md'
mkdir -p "$(dirname "$plan_file")"
if [[ $# -gt 0 ]]; then
  printf '%s\n' "$*" >> "$plan_file"
  echo "recorded $plan_file"
elif [[ -f "$plan_file" ]]; then
  cat "$plan_file"
else
  echo "No plan recorded. Usage: ./tools/d1/plan '<step or decision>'"
fi
