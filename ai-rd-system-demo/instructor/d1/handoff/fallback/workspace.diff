--- handoff/tests/test_status_filter_and_export.py
+++ workspace/tests/test_status_filter_and_export.py
@@ -0,0 +1,70 @@
+from fastapi.testclient import TestClient
+
+from app.main import app
+
+client = TestClient(app)
+
+
+def test_status_filter_matches_exactly_and_combines_with_customer_name():
+    exact = client.get(
+        "/api/financing-applications?status=APPROVED",
+        headers={"X-User": "alice"},
+    ).json()
+    wrong_case = client.get(
+        "/api/financing-applications?status=approved",
+        headers={"X-User": "alice"},
+    ).json()
+    combined = client.get(
+        "/api/financing-applications?customer_name=%E6%99%A8%E6%B5%B7&status=APPROVED",
+        headers={"X-User": "alice"},
+    ).json()
+
+    assert exact["total"] == 2
+    assert all(item["status"] == "APPROVED" for item in exact["items"])
+    assert wrong_case["total"] == 0
+    assert combined["total"] == 1
+    assert combined["items"][0]["id"] == "FA-1005"
+
+
+def test_status_filter_empty_result():
+    body = client.get(
+        "/api/financing-applications?status=UNKNOWN",
+        headers={"X-User": "alice"},
+    ).json()
+
+    assert body["total"] == 0
+    assert body["items"] == []
+
+
+def test_export_enqueues_complete_filtered_result_with_permission_scope():
+    response = client.post(
+        "/api/financing-applications/export?customer_name=%E5%8D%8E%E6%98%9F&status=APPROVED",
+        headers={"X-User": "admin"},
+    )
+    job = response.json()
+
+    assert response.status_code == 202
+    assert job["job_type"] == "financing_applications"
+    assert job["status"] == "QUEUED"
+    assert job["payload"]["requested_by"] == "admin"
+    assert job["payload"]["tenant_scope"] == ["NORTH", "SOUTH"]
+    assert job["payload"]["filters"] == {
+        "customer_name": "华星",
+        "status": "APPROVED",
+    }
+    assert [row["id"] for row in job["payload"]["rows"]] == ["FA-1002"]
+
+    fetched = client.get(f"/api/export-jobs/{job['id']}")
+    assert fetched.status_code == 200
+    assert fetched.json() == job
+
+
+def test_export_never_includes_rows_outside_requesting_user_scope():
+    job = client.post(
+        "/api/financing-applications/export?status=APPROVED",
+        headers={"X-User": "bob"},
+    ).json()
+
+    assert job["payload"]["tenant_scope"] == ["SOUTH"]
+    assert [row["id"] for row in job["payload"]["rows"]] == ["FA-2001"]
+    assert all(row["tenant"] == "SOUTH" for row in job["payload"]["rows"])
