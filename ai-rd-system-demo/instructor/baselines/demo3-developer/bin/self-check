#!/usr/bin/env python3
"""开发侧自检脚本：按 SELF-CHECK.md 的口径逐条检查，结论只对"实现是否符合本工程自己的理解"负责。
不读取任何独立验收资产（cases.json / Source of Truth 都不在本工程内）。"""
from __future__ import annotations

import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))

from fastapi.testclient import TestClient  # noqa: E402

from app.main import app  # noqa: E402

client = TestClient(app)
checks: list[tuple[str, bool]] = []


def record(name: str, ok: bool) -> None:
    checks.append((name, ok))
    print(("PASS" if ok else "FAIL"), name)


def main() -> int:
    pytest_result = subprocess.run(
        [sys.executable, "-m", "pytest", "-q"], cwd=ROOT, capture_output=True, text=True
    )
    record("pytest -q 全部通过", pytest_result.returncode == 0)
    if pytest_result.returncode != 0:
        print(pytest_result.stdout)
        print(pytest_result.stderr)

    combo = client.get(
        "/api/financing-applications?customer_name=%E5%8D%97%E6%B9%BE&status=SUBMITTED",
        headers={"X-User": "bob"},
    ).json()
    record("客户名称 + 状态组合筛选生效", combo["total"] == 1 and combo["items"][0]["id"] == "FA-2002")

    empty = client.get("/api/financing-applications?status=WITHDRAWN", headers={"X-User": "alice"}).json()
    record("空结果正确处理", empty["total"] == 0)

    north = client.get("/api/financing-applications", headers={"X-User": "alice"}).json()
    south = client.get("/api/financing-applications", headers={"X-User": "bob"}).json()
    record(
        "tenant 数据权限未被筛选绕过",
        all(item["tenant"] == "NORTH" for item in north["items"])
        and all(item["tenant"] == "SOUTH" for item in south["items"]),
    )

    job = client.post(
        "/api/financing-applications/export?status=APPROVED", headers={"X-User": "alice"}
    ).json()
    record(
        "导出复用既有异步队列，携带筛选条件和权限范围",
        job["status"] == "QUEUED"
        and job["payload"]["filters"]["status"] == "APPROVED"
        and job["payload"]["tenant_scope"] == ["NORTH"],
    )

    static_html = (ROOT / "static/index.html").read_text(encoding="utf-8")
    record(
        "页面三项功能都有真实入口",
        'id="customer-name-input"' in static_html
        and 'id="status-select"' in static_html
        and 'id="export-btn"' in static_html
        and "job.payload" in static_html,
    )

    overall = all(ok for _, ok in checks)
    print()
    print("SELF-CHECK:", "PASS" if overall else "FAIL")
    return 0 if overall else 1


if __name__ == "__main__":
    raise SystemExit(main())
